{
  "name": "fieldbook",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first route, catalogue, cart and order app for field sales reps.",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/copy-sqljs-wasm.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/copy-sqljs-wasm.mjs && expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "node scripts/copy-sqljs-wasm.mjs && expo export -p web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "expo": "57.0.29",
    "expo-constants": "57.0.22",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.27",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/sql.js": "1.4.11",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "sql.js": "1.14.2"
  }
}
